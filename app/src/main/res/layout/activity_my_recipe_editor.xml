<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" android:fillViewport="true" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical">
<TextView android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="44dp" android:text="‹" android:gravity="center" android:textSize="32sp" android:textColor="@color/primary" android:tag="accent"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp"><TextView android:id="@+id/recipeEditorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Новый рецепт" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/text_primary"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Добавьте описание и ингредиенты" android:textSize="11sp" android:textColor="@color/text_secondary"/></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_recipe_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Название рецепта *" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginBottom="6dp"/><EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_recipe_input" android:padding="10dp" android:hint="Например: Мой фирменный борщ" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:inputType="text" android:gravity="center_vertical" android:singleLine="true"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_recipe_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Подготовка (мин)" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginBottom="6dp"/><EditText android:id="@+id/etPrepTime" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_recipe_input" android:padding="10dp" android:hint="Введите время" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:inputType="number" android:gravity="center_vertical" android:singleLine="true"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_recipe_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Приготовление (мин)" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginBottom="6dp"/><EditText android:id="@+id/etCookTime" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_recipe_input" android:padding="10dp" android:hint="Введите время" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:inputType="number" android:gravity="center_vertical" android:singleLine="true"/></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_recipe_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Порции" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginBottom="6dp"/><EditText android:id="@+id/etServings" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_recipe_input" android:padding="10dp" android:hint="Введите количество" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:inputType="number" android:gravity="center_vertical" android:singleLine="true"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_recipe_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Инструкция" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginBottom="6dp"/><EditText android:id="@+id/etInstructions" android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_recipe_input" android:padding="10dp" android:hint="Опишите шаги приготовления..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:inputType="textMultiLine" android:gravity="top" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ингредиенты" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="8dp" android:layout_marginBottom="6dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnAddIngredient" android:layout_width="match_parent" android:layout_height="48dp" android:text="＋ Добавить ингредиент" android:textAllCaps="false" app:cornerRadius="16dp"/>
<LinearLayout android:id="@+id/llIngredientsPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<LinearLayout android:id="@+id/llIngredientsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"/>
<ProgressBar android:id="@+id/progressBar" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone"/>
<View android:layout_width="1dp" android:layout_height="16dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="6dp" android:text="Отмена" android:textAllCaps="false" app:cornerRadius="16dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:text="Сохранить" android:textAllCaps="false" app:cornerRadius="16dp"/>
</LinearLayout></LinearLayout></ScrollView>